DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_production_db?schema=public"

# --- Интеграция с 1С ---
# Приём данных (GET-запросы к HTTP-сервисам 1С, «ТЗ для запросов GET» v10)
ONEC_BASE_URL="http://10.10.10.81"
ONEC_LOGIN=""
ONEC_PASSWORD=""
ONEC_TIMEOUT_MS="20000"

# Отправка данных и вебхуки (следующий этап)
INTEGRATION_1C_URL=""
INTEGRATION_1C_SECRET="dev-1c-secret"

# Учётка для сервисов /TurnOver/ (get_c, get_d), если она отдельная; пусто — общая
ONEC_TURNOVER_LOGIN=""
ONEC_TURNOVER_PASSWORD=""
# Часовой пояс, в котором 1С называет календарные даты
ONEC_TIMEZONE="Asia/Almaty"

# --- Аутентификация ---
# Секрет JWT; по умолчанию dev-значение из кода — на сервере задать свой
JWT_SECRET=""
# false — вход только по реальным паролям (rotate-passwords)
AUTH_DEMO_MODE="false"

# --- Битрикс24 (заявки на закуп / подряд, задачи оператору 1С) ---
B24_WEBHOOK_URL=""
B24_OPERATOR_ID="1"
B24_SUPPLY_CATEGORY_ID=""
B24_WORKS_CATEGORY_ID=""

# --- Национальный каталог товаров (НКТ): коды NTIN для изделий ЦМК ---
# Ключ из личного кабинета НКТ, раздел «Ключи API». Пусто — фоновые задания
# не поднимаются: паспорта заводятся, очередь копится, обмена нет.
NKT_API_KEY=""
# Тестовый контур на время отладки: NKT_BASE_URL="https://stg.nct.kz/gwp"
# Пусто — прод https://nationalcatalog.kz/gwp
NKT_BASE_URL=""

# Значения с символом $ — только в одинарных кавычках: и bash (scripts/dev.sh),
# и docker compose (env_file) раскрывают $… внутри двойных кавычек.
# На сервере JWT_SECRET и INTEGRATION_1C_SECRET обязательны (REQUIRE_SECRETS=1
# в docker-compose.yml): с пустыми значениями контейнер не стартует.

# --- Раздельный деплой: фронт на Vercel, Go рядом с базой на VPS ---
# Домен API (A-запись на этот VPS); Caddy выпустит сертификат сам
API_DOMAIN="api.example.kz"
LETSENCRYPT_EMAIL="admin@example.kz"
# Откуда фронту разрешено обращаться; пусто — как раньше «*»
CORS_ORIGINS="https://cmk-avrora-erp.vercel.app"
